# Скопируйте в .env и задайте свои значения (не короче 8 символов каждое).
# Сгенерировать случайное значение: openssl rand -hex 24

# Пароль для входа в панель через браузер.
PANEL_PASSWORD=

# Общий секрет, с которым подключается локальный агент (token в agent.toml).
AGENT_TOKEN=

# Адрес и порт на хосте. По умолчанию 127.0.0.1:8080 — только для прокси на том же хосте.
#PANEL_LISTEN=127.0.0.1:8080

# Домен для профиля tls (docker compose --profile tls up -d).
#DOMAIN=panel.example.com

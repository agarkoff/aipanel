# Скопируйте в .env и задайте свои значения (не короче 8 символов каждое).
# Сгенерировать случайное значение: openssl rand -hex 24

# Пользователи панели: JSON-объект «имя -> пароль и токен агента».
# Пароль вводится в браузере, token прописывается в agent.toml на машинах этого пользователя.
# Пароли и токены у разных пользователей не должны совпадать: по токену сервер
# определяет владельца агента, а по паролю — пользователя при входе.
PANEL_USERS={"alice":{"password":"","token":""},"bob":{"password":"","token":""}}

# Адрес и порт на хосте. По умолчанию 127.0.0.1:8080 — только для прокси на том же хосте.
#PANEL_LISTEN=127.0.0.1:8080

# Домен для профиля tls (docker compose --profile tls up -d).
#DOMAIN=panel.example.com
